{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "dashboard": {
      "root": "frontend/",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "api": {
      "root": "./",
      "framework": "fastapi",
      "entrypoint": "backend.app.main:app",
      "functions": {
        "backend/app/main.py": {
          "maxDuration": 300,
          "excludeFiles": "{frontend/**,bug-bounty/**,crispr_products/**,docs/**,infra/**,tools/**,**/tests/**,**/test_*.py,.git/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "dashboard" }
    }
  ]
}
